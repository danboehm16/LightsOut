<?xml version="1.0" encoding="utf-8"?>
<!--
    Classic theme for Lights Out – inspired by the Windows 7 Games era.
    Colours, fonts, and control styles live here so that future themes can
    simply supply a replacement ResourceDictionary without touching any XAML
    layout or C# code.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         Colour palette (Windows 7 era blues and neutrals)
    ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="#1F3A5C" />
    <SolidColorBrush x:Key="TitleBarBrush"         Color="#0D2137" />
    <SolidColorBrush x:Key="ControlBarBrush"       Color="#1A3050" />
    <SolidColorBrush x:Key="GameAreaBrush"         Color="#162840" />
    <SolidColorBrush x:Key="StatusBarBrush"        Color="#0D2137" />
    <SolidColorBrush x:Key="TitleForegroundBrush"  Color="#D0E8FF" />
    <SolidColorBrush x:Key="LabelForegroundBrush"  Color="#A8CCE8" />
    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#8AADCC" />
    <SolidColorBrush x:Key="CellOnBrush"           Color="#CC1A1A" />
    <SolidColorBrush x:Key="CellOffBrush"          Color="#0A0A0A" />
    <SolidColorBrush x:Key="CellBorderBrush"       Color="#3A6A9A" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2C5F8A" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#D0E8FF" />
    <SolidColorBrush x:Key="ButtonBorderBrush"     Color="#4A8FCA" />
    <SolidColorBrush x:Key="WinOverlayBrush"       Color="#CC000A18" />
    <SolidColorBrush x:Key="WinTextBrush"          Color="#FFD700" />

    <!-- ═══════════════════════════════════════════════════════════
         Layout styles
    ══════════════════════════════════════════════════════════════ -->

    <Style x:Key="MainGridStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    </Style>

    <Style x:Key="TitleBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TitleBarBrush}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="ControlBarStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="{StaticResource ControlBarBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Spacing" Value="10" />
    </Style>

    <Style x:Key="GameAreaStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GameAreaBrush}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusBarBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderBrush" Value="{StaticResource CellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Text styles
    ══════════════════════════════════════════════════════════════ -->

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TitleForegroundBrush}" />
        <Setter Property="CharacterSpacing" Value="200" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource LabelForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource StatusForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WinMessageStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource WinTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Button style (Windows 7-era raised look)
    ══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ClassicButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         ComboBox style
    ══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ClassicComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="80" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Game cell (light) button style
    ══════════════════════════════════════════════════════════════ -->

    <Style x:Key="CellButtonStyle" TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource CellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
