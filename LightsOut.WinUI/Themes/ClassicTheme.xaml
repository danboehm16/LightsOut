<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 7-era classic blues -->
    <Color x:Key="TitleBarColor">#FF4D7EBF</Color>
    <Color x:Key="TitleBarGradientColor">#FF2B5A9E</Color>
    <Color x:Key="WindowBackgroundColor">#FFD4D0C8</Color>
    <Color x:Key="CellOnColor">#FFFFD700</Color>
    <Color x:Key="CellOffColor">#FF3A3A3A</Color>
    <Color x:Key="ButtonFaceColor">#FFECE9D8</Color>
    <Color x:Key="ButtonBorderColor">#FF6B8EB5</Color>

    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CellOnBrush" Color="{StaticResource CellOnColor}"/>
    <SolidColorBrush x:Key="CellOffBrush" Color="{StaticResource CellOffColor}"/>
    <SolidColorBrush x:Key="ButtonFaceBrush" Color="{StaticResource ButtonFaceColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ButtonBorderColor}"/>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="ClassicButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="CellButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

</ResourceDictionary>
